---
import Base from '../layouts/Base.astro';
import Goupil from '../components/Goupil.astro';
import themes from '../data/themes.json';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
type Theme = (typeof themes)[number] & { pret?: boolean; lien?: string };
// les vrais quiz avant l'essai de géographie
const prets = (themes as Theme[]).filter((t) => t.pret).sort((a, b) => Number(!!b.lien) - Number(!!a.lien));
const aVenir = (themes as Theme[]).filter((t) => !t.pret);
const voie = (c: string) => `Voie ${/^[AEÉIOU]/.test(c) ? "de l'" : 'du '}${c.toLowerCase()}`;
---
<Base titre="Choisir un quiz">
  <main class="page">
    <header class="entete">
      <div>
        <p class="salut">Bonjour, gueux&#8239;!</p>
        <h1>Quel savoir veux-tu conquérir&#8239;?</h1>
      </div>
      <Goupil taille={80} class="goupil" />
    </header>

    <!-- Les thèmes jouables d'abord ; les autres attendent, sans lien, dans « Bientôt au feu ». -->
    <h2 class="rubrique">Prêts à jouer</h2>
    <ul class="grille">
      {prets.map((t) => (
        <li class="large">
          <a class="theme pret" href={`${base}/theme/${t.id}`}>
            <span class="nom">{t.nom}</span>
            <span class="matieres">{t.matieres}</span>
            <span class="carriere">{voie(t.carriere)}</span>
            <span class="jouer">{t.lien ? 'Jouer' : 'Essai · 3 questions'}</span>
          </a>
        </li>
      ))}
    </ul>

    <h2 class="rubrique">Bientôt au feu</h2>
    <ul class="grille">
      {aVenir.map((t) => (
        <li>
          <div class="theme a-venir">
            <span class="nom">{t.nom}</span>
            <span class="matieres">{t.matieres}</span>
            <span class="carriere">{voie(t.carriere)}</span>
          </div>
        </li>
      ))}
    </ul>
  </main>
</Base>

<style>
  .entete {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 24px;
  }
  .salut { margin: 0 0 6px; color: var(--encre-douce); font-weight: 500; }
  h1 { font-size: 1.9rem; }
  .goupil { flex-shrink: 0; }

  .grille {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }
  .theme {
    display: flex;
    flex-direction: column;
    gap: 4px;
    height: 100%;
    min-height: 128px;
    padding: 16px;
    border-radius: var(--arrondi);
    background: var(--blanc);
    text-decoration: none;
    color: var(--encre);
  }
  .theme.pret {
    min-height: 0;
    background: var(--sinople);
    color: var(--blanc);
    box-shadow: 0 var(--epaisseur-ombre) 0 var(--sinople-fonce);
  }
  .nom { font-weight: 700; font-size: 1.15rem; }
  .matieres { font-size: .8rem; line-height: 1.3; }
  .carriere { font-size: .85rem; color: var(--encre-douce); }
  .theme.pret .carriere { color: var(--blanc); }
  .rubrique { margin: 28px 0 12px; font-size: 1.05rem; color: var(--encre-douce); font-weight: 600; }
  .entete + .rubrique { margin-top: 0; }
  .large { grid-column: span 2; }
  .theme.a-venir { min-height: 0; background: transparent; border: 2px dashed color-mix(in srgb, var(--encre-douce) 35%, transparent); }
  .a-venir .nom { font-size: 1rem; }
  .jouer {
    margin-top: auto;
    align-self: flex-start;
    padding: 6px 14px;
    border-radius: var(--arrondi-bouton);
    font-size: .85rem;
    font-weight: 600;
  }
  .jouer { background: var(--blanc); color: var(--sinople-fonce); }
</style>
