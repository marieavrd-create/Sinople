---
import Base from '../../../layouts/Base.astro';
import LecteurLecon, { type QuestionQcm } from '../../../islands/LecteurLecon';
import { getCollection } from 'astro:content';
import themes from '../../../data/themes.json';

// Une page par leçon, lue dans src/content/questions/<thème>/<étape>-<leçon>.json.
// Pour ajouter des questions, il suffit de modifier ou d'ajouter un de ces fichiers.
export async function getStaticPaths() {
  const lecons = await getCollection('questions');
  const chemins = (theme: string) =>
    lecons.filter((l) => l.data.theme === theme).map(({ data: { id, etape, lecon, epreuve } }) => ({ id, etape, lecon, epreuve }));
  return lecons.map(({ data }) => ({
    params: { theme: data.theme, lecon: `${data.etape}-${data.lecon}` },
    props: { nomTheme: themes.find((t) => t.id === data.theme)?.nom ?? data.theme, partie: { nom: data.titre, questions: data.questions }, lecon: data, chemin: chemins(data.theme) },
  }));
}

const { nomTheme, partie, lecon, chemin } = Astro.props;
const infosTheme = themes.find((t) => t.id === lecon.theme)!;
const article = (a: string) => (/^[aeéiou]/i.test(a) ? "l'" : ['pie', 'grenouille'].includes(a) ? 'la ' : 'le ') + a;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const ordre = { facile: 0, moyen: 1, difficile: 2 } as Record<string, number>;
// Les QCM seulement pour l'instant (la carte et la saisie arrivent en version 3), du plus facile au plus difficile.
const questions: QuestionQcm[] = partie.questions
  .flatMap((q) => (q.type === 'qcm' ? [q] : []))
  .sort((a, b) => ordre[a.niveau] - ordre[b.niveau]);
---
<Base titre={`${nomTheme} · ${partie.nom}`} nav={false}>
  <main class="page">
    <LecteurLecon
      client:load
      base={base}
      nomTheme={nomTheme}
      lecon={{ id: lecon.id, theme: lecon.theme, etape: lecon.etape, titre: lecon.titre, epreuve: lecon.epreuve }}
      questions={questions}
      chemin={chemin}
      animal={article(infosTheme.animal)}
      grades={infosTheme.grades}
    />
  </main>
</Base>

<style is:global>
  /* Le lecteur de leçon (src/islands/LecteurLecon.tsx). */
  .lecteur { padding-bottom: 260px; }
  .lecteur .haut { display: flex; align-items: center; gap: 12px; margin-bottom: 28px; }
  .lecteur .fermer { text-decoration: none; font-size: 1.3rem; color: var(--encre-douce); }
  .lecteur .barre { flex: 1; height: 16px; border-radius: var(--arrondi-bouton); background: var(--sinople-clair); overflow: hidden; }
  .lecteur .remplissage { height: 100%; background: var(--sinople); border-radius: inherit; transition: width .3s; }

  .buches { display: inline-flex; gap: 1px; flex: none; }
  .buche .bois { fill: #8a5a35; }
  .buche .cerne { fill: #c9955f; }
  .buche .flammeche { fill: var(--goupil); }
  .buche.brulee .bois { fill: #b9b2a5; }
  .buche.brulee .cerne { fill: #d6d0c4; }
  .buche.brulee .flammeche { fill: none; }

  .lecteur .theme { margin: 0 0 8px; color: var(--sinople-fonce); font-weight: 600; font-size: .9rem; }
  .lecteur .question { font-size: 1.6rem; margin: 0 0 20px; }
  .lecteur .choix { display: grid; gap: 10px; }
  .lecteur .reponse {
    display: flex; align-items: center; gap: 12px; min-height: 56px; padding: 14px 18px;
    border: 3px solid transparent; border-radius: var(--arrondi); background: var(--blanc);
    font: 500 1.05rem var(--police-texte); color: var(--encre); text-align: left; cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  .lecteur .reponse::before { content: ''; width: 14px; height: 14px; border-radius: 50%; border: 2px solid var(--encre-douce); flex-shrink: 0; }
  .lecteur .reponse:disabled { cursor: default; }
  .lecteur .reponse[aria-checked='true'] { border-color: var(--sinople); background: var(--sinople-clair); }
  .lecteur .reponse[aria-checked='true']::before { background: var(--sinople); border-color: var(--sinople); }
  .lecteur .reponse.juste { border-color: var(--juste); background: var(--sinople-clair); }
  .lecteur .reponse.faux { border-color: var(--faux); background: color-mix(in srgb, var(--faux) 15%, var(--blanc)); }

  .lecteur .verdict { position: fixed; left: 0; right: 0; bottom: 0; padding: 16px 16px 24px; background: var(--creme); }
  .lecteur .verdict > * { max-width: 448px; margin-left: auto; margin-right: auto; }
  .lecteur .message { margin: 0 auto 6px; font-weight: 700; min-height: 1.4em; }
  .lecteur .explication { margin: 0 auto 12px; font-size: .92rem; color: var(--encre); }
  .lecteur .source { color: var(--encre-douce); }
  .lecteur .verdict .bouton { width: 100%; }
  .lecteur .verdict.ok { background: var(--sinople-clair); }
  .lecteur .verdict.ok .message { color: var(--sinople-fonce); }
  .lecteur .verdict.rate { background: color-mix(in srgb, var(--faux) 15%, var(--creme)); }
  .lecteur .verdict.rate .message { color: var(--faux); }
  .lecteur .verdict.rate .bouton { background: var(--faux); box-shadow: 0 var(--epaisseur-ombre) 0 color-mix(in srgb, var(--faux) 70%, black); }

  .lecteur.ecran-centre { text-align: center; display: grid; justify-items: center; gap: 12px; padding-top: 40px; }
  .ecran-centre h1 { margin: 0; }
  .ecran-centre .sous-titre { margin: 0 0 8px; color: var(--encre-douce); font-size: 1.05rem; max-width: 34ch; }
  .ecran-centre .bouton { width: 100%; max-width: 320px; }
  .gains { margin: 0 0 16px; width: 100%; max-width: 320px; display: grid; gap: 6px; }
  .gains div { display: flex; justify-content: space-between; padding: 8px 14px; border-radius: 14px; background: var(--blanc); }
  .gains dt { color: var(--encre-douce); }
  .gains dd { margin: 0; font-weight: 700; color: var(--sinople-fonce); }
  .gains .total { background: var(--sinople-clair); }
  .ecran-centre .promotion { margin: 0 0 4px; font: italic 1.3rem var(--police-recit); color: var(--sinople-fonce); }
  .gains .total dd { color: var(--or); font-size: 1.2rem; text-shadow: 0 1px 0 #7a5d1c; }
  .feu-eteint .fumee { fill: none; stroke: #b9b2a5; stroke-width: 6; stroke-linecap: round; opacity: .7; }
  @media (prefers-reduced-motion: no-preference) {
    .feu-eteint .fumee { animation: fumee 3s ease-in-out infinite; }
    @keyframes fumee { 50% { opacity: .3; transform: translateY(-4px); } }
  }
</style>
