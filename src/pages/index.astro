---
import Base from '../layouts/Base.astro';
import Feu from '../components/Feu.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// Valeurs d'exemple : elles viendront du compte du joueur à l'étape 2 (Supabase).
const joueur = { jour: 1, points: 0, grade: 'Gueux', recit: 'Le renard rumine seul son complot contre le roi' };
---
<Base titre="Accueil" fond="#191826">
  <main class="accueil">
    <div class="ciel">
      <!-- Le feu des conjurés : le renard seul au début, puis un animal par thème joué.
           La vidéo du goupil conquérant reste dans public/accueil/ si on veut la remettre. -->
      <Feu accueil />
    </div>

    <section class="compteurs">
      <p class="jour">Jour {joueur.jour}</p>
      <p class="points" id="points">{joueur.points}</p>
      <p class="unite">points de savoir</p>
      <p class="grade">{joueur.grade}</p>
      <p class="recit" id="recit">{joueur.recit}</p>
      <a class="bouton" href={`${base}/themes`}>Prendre la route</a>
    </section>
  </main>
</Base>

<script>
  import { lireEtat, stockageNavigateur } from '../lib/stockage/local';
  // En attendant les comptes : points et conjurés lus sur l'appareil.
  const etat = lireEtat(stockageNavigateur());
  document.getElementById('points')!.textContent = String(etat.profil.points);
  const n = etat.conjures.length;
  if (n > 0) document.getElementById('recit')!.textContent =
    n === 1 ? 'Un conjuré écoute le renard au coin du feu' : `${n} conjurés écoutent le renard au coin du feu`;
</script>

<style>
  /* L'accueil tient dans un seul écran, sans défilement : le feu prend la place qui reste. */
  .accueil {
    height: 100dvh;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    color: var(--creme);
    text-align: center;
  }
  .ciel { flex: 1; min-height: 0; width: 100%; overflow: hidden; background: #1d1f4a; }
  .ciel :global(.feu) { height: 100%; }
  .compteurs {
    flex: none;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 8px 16px 96px;
    max-width: 480px;
    margin: 0 auto;
    width: 100%;
  }
  .compteurs p { margin: 0; }
  .jour { font: 1.25rem var(--police-recit); color: var(--creme); }
  .points {
    font: 3.2rem/1 var(--police-recit);
    color: var(--or);
    margin-top: 4px !important;
  }
  .unite { font: 1rem var(--police-recit); color: var(--or); }
  .grade {
    margin-top: 10px !important;
    font-size: .85rem;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--montagne-1);
  }
  .recit { font: italic 1.15rem var(--police-recit); margin-bottom: 16px !important; }
  .bouton { max-width: 320px; }
</style>
