---
// Page affichée quand une adresse n'existe pas (GitHub Pages sert dist/404.html).
import Base from '../layouts/Base.astro';
import Goupil from '../components/Goupil.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base titre="Chemin introuvable">
  <main class="page perdu">
    <Goupil taille={120} />
    <h1>Ce chemin ne mène nulle part</h1>
    <p>Même le plus rusé des goupils s'égare parfois. La page que vous cherchez n'existe pas, ou plus.</p>
    <a class="bouton" href={`${base}/`}>Retour au feu</a>
  </main>
</Base>

<style>
  .perdu { text-align: center; display: grid; justify-items: center; gap: 12px; padding-top: 72px; }
  p { color: var(--encre-douce); margin: 0 0 12px; max-width: 32ch; }
  .bouton { max-width: 320px; }
</style>
