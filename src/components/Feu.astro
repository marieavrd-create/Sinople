---
// Le feu de camp du renard et de ses conjurés.
// « actif » : l'animal du thème choisi (cerf, hibou…). Il s'allume en couleur ;
// les autres restent dans l'ombre, on ne voit que leurs yeux jaunes.
// Sans « actif », tous les animaux sont allumés.
// « accueil » : écran d'accueil. Seul le renard est là au début ; chaque thème joué
// fait venir son animal, et le feu grandit (pierres à 3 animaux, bannières à 6).
import themes from '../data/themes.json';
interface Props { actif?: string; accueil?: boolean }
const { actif, accueil = false } = Astro.props;
const sansAccent = (a: string) => a.normalize('NFD').replace(/[\u0300-\u036f]/g, '');
const animalDuTheme = Object.fromEntries(themes.map((t) => [t.id, sansAccent(t.animal)]));

// Chaque animal : position (x, y = ses pieds), taille, sens (miroir = regarde vers la gauche),
// son dessin en couleur, la place de ses yeux pour la version dans l'ombre,
// et celles de son cou et du haut de sa tête, où se posent les tenues de grade.
const animaux = [
  { id: 'cerf', cou: [14, -44], tete: [24, -60], x: 112, y: 284, s: 1.35, miroir: false, yeux: [[25, -53]],
    corps: `<path d="M15-66 8-86M10-77 1-82M20-68 27-90M24-79 33-84" stroke="#d8c39a" stroke-width="3" stroke-linecap="round" fill="none"/>
      <path d="M-30 0-28-30C-28-40-20-44 0-44L10-46 14-66 20-68 22-60 26-58 24-52C28-52 32-50 35-46L22-44 18-34 16 0H12L11-28H-19L-22 0Z" fill="#9a6a3e"/>
      <path d="M-26-32C-20-30-6-30 8-32L12-36C0-38-16-38-26-36Z" fill="#e8d2b0"/><path d="M33-47 35-46 33-44Z" fill="#2b1a22"/>
      <circle cx="25" cy="-53" r="1.6" fill="#2b1a22"/>` },
  { id: 'belier', cou: [17, -22], tete: [26, -35], x: 170, y: 270, s: 1.2, miroir: false, yeux: [[29, -27]],
    corps: `<path d="M-15-9V0M-8-9V0M9-9V0M15-9V0" stroke="#3a2e28" stroke-width="3.4" stroke-linecap="round"/>
      <path d="M-22-12C-28-16-26-24-19-24-18-31-10-33-5-29-1-35 8-34 10-28 17-30 22-24 20-17 24-12 19-6 13-8 9-4 1-4-4-8-10-4-17-6-22-12Z" fill="#efe6d2" stroke="#b8a788" stroke-width="1.4"/>
      <path d="M-14-19c2-2 5-2 6 0M0-23c2-2 5-2 6 0M-6-13c2-2 5-2 6 0M8-15c2-2 5-2 6 0" fill="none" stroke="#c9b994" stroke-width="1.3" stroke-linecap="round"/>
      <path d="M15-29C21-37 33-35 36-27 38-20 31-15 24-17 19-19 15-24 15-29Z" fill="#4a3c32"/>
      <path d="M18-32a7 7 0 1 1-2 10" fill="none" stroke="#d9b56f" stroke-width="3.6" stroke-linecap="round"/>
      <circle cx="29" cy="-27" r="1.5" fill="#f6f1e3"/>` },
  { id: 'pie', cou: [5, -21], tete: [8, -33], x: 400, y: 262, s: 1.25, miroir: true, yeux: [[10, -29]],
    corps: `<path d="M-8-8-36-3-34 1-6-4Z" fill="#1e3a5a"/>
      <path d="M-20-4-8-10C-8-22-2-30 6-32 10-34 14-32 16-30L24-28 16-26C16-18 12-10 4-6L3 0H0V-5Z" fill="#1e1e28"/>
      <path d="M-2-10C0-18 6-22 10-22 10-14 6-10 0-8Z" fill="#f6f1e3"/><path d="M-12-12C-8-18-4-20 0-20" stroke="#2c5d8a" stroke-width="3" fill="none"/>
      <circle cx="10" cy="-29" r="1.3" fill="#f2b134"/>` },
  { id: 'paon', cou: [6, -29], tete: [6, -46], x: 470, y: 280, s: 1.3, miroir: true, yeux: [[6, -40]],
    corps: `<path d="M-40-6C-44-40-20-62 0-58-12-48-14-26-8-6Z" fill="#1f7a6a"/>
      <g fill="#e3b448"><circle cx="-30" cy="-34" r="3"/><circle cx="-22" cy="-48" r="3"/><circle cx="-10" cy="-54" r="3"/><circle cx="-34" cy="-20" r="3"/><circle cx="-20" cy="-30" r="3"/></g>
      <g fill="#1e4fa0"><circle cx="-30" cy="-34" r="1.4"/><circle cx="-22" cy="-48" r="1.4"/><circle cx="-10" cy="-54" r="1.4"/><circle cx="-34" cy="-20" r="1.4"/><circle cx="-20" cy="-30" r="1.4"/></g>
      <path d="M-8 0C-12-12-6-22 2-24L4-44C8-46 10-44 10-40L8-24C12-18 10-6 6 0Z" fill="#2a6fd0"/>
      <path d="M6-44 4-51M8-45 9-52" stroke="#2a6fd0" stroke-width="1.5"/><path d="M10-42 13-41 10-40Z" fill="#c9a66b"/>
      <circle cx="6" cy="-40" r="1.2" fill="#fff"/>` },
  { id: 'sanglier', cou: [8, -25], tete: [12, -33], x: 128, y: 320, s: 1.4, miroir: false, yeux: [[16, -26]],
    corps: `<path d="M-30 0-28-10C-30-24-20-34-4-34 8-34 18-30 24-22L34-14 30-8H22L20 0H16L14-8H-18L-20 0Z" fill="#5a3e2e"/>
      <path d="M-22-30-18-38-14-31-10-39-6-32-2-38 2-33" fill="none" stroke="#3a281e" stroke-width="2"/>
      <path d="M31-15 34-14 32-11Z" fill="#2b1a22"/><path d="M28-12 32-19" stroke="#fff1e2" stroke-width="2" stroke-linecap="round"/>
      <path d="M8-30 10-36 14-30Z" fill="#3a281e"/><circle cx="16" cy="-26" r="1.4" fill="#2b1a22"/>` },
  { id: 'renard', cou: [8, -33], tete: [9, -54], x: 232, y: 318, s: 1.55, miroir: false, yeux: [[12, -47]],
    corps: `<path d="M-14 0C-18-20-14-38-4-48L0-60 4-52 8-62 12-50C20-48 26-44 32-41L22-37C14-35 10-30 10-20 12-10 14-4 16 0Z" fill="#d9583c"/>
      <path d="M-14 0C-36-2-42-16-33-24-27-12-19-7-10-6Z" fill="#d9583c"/><path d="M-36-18C-38-12-35-6-30-4-33-10-33-14-36-18Z" fill="#fff1e2"/>
      <path d="M6-30C10-32 16-34 22-37 18-31 12-28 6-26Z" fill="#fff1e2"/><path d="M0-60 4-52 2-54Z" fill="#2b1a22"/>
      <path d="M31-42 33-41 31-39Z" fill="#2b1a22"/><path d="M9-48c2-1 5-1 7 1-2 1-5 1-7-1z" fill="#f2b134"/>` },
  { id: 'hibou', cou: [0, -28], tete: [0, -46], x: 368, y: 316, s: 1.45, miroir: true, yeux: [[-5, -36], [5, -36]],
    corps: `<path d="M-13 0C-17-16-15-34-11-40L-13-51-5-45H5L13-51 11-40C15-34 17-16 13 0Z" fill="#8a6240"/>
      <path d="M-8-2C-10-14-8-26 0-28 8-26 10-14 8-2Z" fill="#d9b98a"/>
      <circle cx="-5" cy="-36" r="5.5" fill="#e8d2a8"/><circle cx="5" cy="-36" r="5.5" fill="#e8d2a8"/>
      <circle cx="-5" cy="-36" r="2.8" fill="#f2b134"/><circle cx="5" cy="-36" r="2.8" fill="#f2b134"/>
      <circle cx="-5" cy="-36" r="1.3" fill="#2b1a22"/><circle cx="5" cy="-36" r="1.3" fill="#2b1a22"/><path d="M-1.5-32h3L0-28Z" fill="#3a2a22"/>` },
  { id: 'lapin', cou: [5, -22], tete: [6, -34], x: 430, y: 314, s: 1.35, miroir: true, yeux: [[8, -30]],
    corps: `<path d="M-14 0C-18-12-10-22 0-24 2-28 3-32 3-35L0-52C4-53 7-46 7-38L9-54C13-53 13-44 11-34 16-32 18-28 16-25L11-23C13-14 11-6 8 0Z" fill="#a08a78"/>
      <path d="M2-50C4-48 5-44 5-39M10-51C11-48 11-44 10-38" stroke="#e8b4b0" stroke-width="1.6" fill="none"/>
      <path d="M-14 0C-20-2-22-8-17-10-14-6-12-4-10-2Z" fill="#f6f1e3"/><circle cx="8" cy="-30" r="1.3" fill="#2b1a22"/>` },
  { id: 'grenouille', cou: [3, -14], tete: [3, -28], x: 498, y: 324, s: 1.3, miroir: true, yeux: [[-2, -25], [8, -25]],
    corps: `<path d="M-18 0C-20-10-14-18-6-20-8-27-1-31 3-26 7-31 15-27 12-20 19-16 21-8 17 0Z" fill="#5aa04a"/>
      <path d="M-8-2C-8-10-2-14 6-14 12-12 12-6 10-2Z" fill="#c8e09a"/>
      <circle cx="-2" cy="-25" r="2.4" fill="#f2d24a"/><circle cx="8" cy="-25" r="2.4" fill="#f2d24a"/>
      <circle cx="-2" cy="-25" r="1.1" fill="#2b1a22"/><circle cx="8" cy="-25" r="1.1" fill="#2b1a22"/>` },
];
// Tenue selon le grade (spécification fonctionnelle § 5) : écharpe au grade 2, médaille au 3,
// chaperon au 4, plume au 5, couronne au 6 (la carrière). Elles s'affichent selon data-grade.
function tenue([cx, cy]: number[], [tx, ty]: number[]) {
  return `<g class="acc g2"><path d="M${cx - 6} ${cy - 1}q6 4 12 0v3q-6 4-12 0z" fill="#3fae68"/><path d="M${cx + 3} ${cy + 2}l2 7 3-1-2-6z" fill="#2f8f54"/></g>
    <circle class="acc g3" cx="${cx}" cy="${cy + 6}" r="2.2" fill="#e3b448" stroke="#a5802c" stroke-width=".6"/>
    <path class="acc g4" d="M${tx - 6} ${ty}h12l-2-5h-8z" fill="#7a2e3a"/>
    <path class="acc g5" d="M${tx + 3} ${ty - 4}q5-6 2-11" stroke="#e3b448" stroke-width="1.6" fill="none" stroke-linecap="round"/>
    <path class="acc g6" d="M${tx - 6} ${ty}h12l1-7-3.5 3.5-3.5-4.5-3.5 4.5-3.5-3.5z" fill="#e3b448" stroke="#a5802c" stroke-width=".5"/>`;
}
// Écran avant quiz et fin de leçon : l'animal du thème vient s'asseoir au premier plan,
// face au renard, de l'autre côté du feu. Les petits animaux (bélier, grenouille…) sont agrandis
// pour paraître au moins aussi grands que le renard : c'est leur thème, ils sont au premier plan.
const placeDevant = { x: 368, y: 338, s: 1.15, hauteur: 80, agrandiMax: 1.6 };
const echelleDevant = (b: { s: number; tete: number[] }) =>
  Math.max(b.s * placeDevant.s, Math.min(placeDevant.agrandiMax, placeDevant.hauteur / (10 - b.tete[1])));
const pierres = Array.from({ length: 14 }, (_, i) => {
  const a = (Math.PI * 2 * i) / 14;
  return [300 + 40 * Math.cos(a), 322 + 10 * Math.sin(a)];
});
---
<svg class:list={['feu', { accueil, 'gros-plan': actif }]}
  viewBox={actif ? '160 130 280 220' : '50 100 500 250'}
  preserveAspectRatio={accueil ? 'xMidYMax meet' : actif ? 'xMidYMax slice' : undefined} role="img" data-stade="1" data-animaux={JSON.stringify(animalDuTheme)}
  aria-label={actif ? `Le feu des conjurés : l'animal du thème s'avance dans la lumière` : 'Le renard et ses conjurés autour du feu'}>
  <defs>
    <linearGradient id="feu-ciel" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#1d1f4a" /><stop offset="1" stop-color="#4b3a6e" /></linearGradient>
    <radialGradient id="feu-lueur"><stop offset="0" stop-color="#ffb04a" stop-opacity=".6" /><stop offset="1" stop-color="#ffb04a" stop-opacity="0" /></radialGradient>
    <radialGradient id="feu-halo"><stop offset="0" stop-color="#ffe2a0" stop-opacity=".55" /><stop offset="1" stop-color="#ffe2a0" stop-opacity="0" /></radialGradient>
  </defs>
  <rect x="-1000" width="2600" height="360" fill="url(#feu-ciel)" />
  <g class="loin">
  <g fill="#fff" opacity=".7"><circle cx="80" cy="115" r="1.2" /><circle cx="200" cy="130" r="1" /><circle cx="520" cy="110" r="1.3" /><circle cx="300" cy="112" r="1" /></g>
  <circle cx="220" cy="135" r="18" fill="#f6edd0" opacity=".9" />
  <!-- le château du roi lion, au loin -->
  <path d="M-1000 190 0 210 120 160 230 190 340 140 450 170 600 130 1600 170V360H-1000Z" fill="#3a2f5e" />
  <g transform="translate(0 50)">
  <g fill="#2a2248"><rect x="430" y="96" width="44" height="50" /><rect x="420" y="80" width="12" height="66" /><rect x="472" y="80" width="12" height="66" /><path d="M420 80l6-12 6 12zM472 80l6-12 6 12zM444 96l8-18 8 18z" /></g>
  <path d="M452 78v-12l12 4-12 4" fill="#e3b448" />
  </g>
  </g>
  <g class="milieu"><path d="M-1000 250 0 260 150 236 300 250 450 232 600 250 1600 240V360H-1000Z" fill="#2a2a44" /></g>
  <path d="M-1000 300H0Q300 280 600 300H1600V360H-1000Z" fill="#191826" />
  <ellipse cx="300" cy="320" rx="260" ry="70" fill="url(#feu-lueur)" />

  <g class="bannieres">
    {[[262, -1], [338, 1]].map(([x, f]) => (
      <g><line x1={x} y1="326" x2={x} y2="236" stroke="#3a2a22" stroke-width="3" /><path d={`M${x} 240h${22 * f}v32l${-11 * f} -8 ${-11 * f} 8z`} fill="#3fae68" /><circle cx={x + 11 * f} cy="252" r="4" fill="#e3b448" /></g>
    ))}
  </g>
  {/* l'animal du thème est dessiné après le feu, pour passer devant les pierres */}
  {[...animaux.filter((a) => a.id !== actif || a.id === 'renard'), 'feu' as const, ...animaux.filter((a) => a.id === actif && a.id !== 'renard')].map((b) => {
    if (b === 'feu') return (
      <Fragment>
        <g class="pierres">{pierres.map(([x, y]) => <ellipse cx={x} cy={y} rx="8" ry="5" fill="#6b6170" />)}</g>
        <g stroke="#4a2c1c" stroke-width="8" stroke-linecap="round"><line x1="282" y1="326" x2="318" y2="314" /><line x1="282" y1="314" x2="318" y2="326" /></g>
        <g class="flamme">
          <path d="M276 322C276 296 292 280 300 250 308 280 324 296 324 322Z" fill="#f28a2e" />
          <path d="M288 322C288 306 298 298 300 284 304 298 312 306 312 322Z" fill="#ffd36b" />
        </g>
      </Fragment>
    );
    // le renard, héros de l'histoire, reste toujours éclairé
    const etat = !actif || actif === b.id || b.id === 'renard' ? 'allume' : 'eteint';
    const absent = accueil && b.id !== 'renard';
    const devant = actif === b.id && b.id !== 'renard';
    const a = devant ? { ...b, x: placeDevant.x, y: placeDevant.y, s: echelleDevant(b), miroir: true } : b;
    const t = `translate(${a.x} ${a.y}) scale(${a.miroir ? -a.s : a.s} ${a.s})`;
    return (
      <g class:list={['animal', etat, { absent }]} data-animal={a.id}>
        {devant && <ellipse cx={a.x} cy={a.y - 30 * a.s} rx={52 * a.s} ry={50 * a.s} fill="url(#feu-halo)" />}
        <g transform={t}>
          <g class="corps" set:html={a.corps + tenue(a.cou, a.tete)} />
          {etat === 'eteint' && <g class="yeux">{a.yeux.map(([x, y]) => <circle cx={x} cy={y} r="1.9" />)}</g>}
        </g>
      </g>
    );
  })}
</svg>

<style>
  .feu { display: block; width: 100%; height: auto; }
  /* accueil sur écran large : le ciel, les montagnes et le sol continuent sur les côtés */
  .feu.accueil { overflow: visible; }
  /* gros plan sur le renard et l'animal du thème : une hauteur fixe, la scène est recadrée */
  .feu.gros-plan { height: clamp(240px, 44dvh, 440px); max-width: 680px; margin-inline: auto; }
  @media (min-width: 700px) { .feu.gros-plan { border-radius: var(--arrondi); } }
  /* écran d'accueil : les animaux arrivent, le feu grandit */
  .absent { opacity: 0; }
  .animal { transition: opacity .8s; }
  .accueil .pierres, .accueil .bannieres { display: none; }
  .accueil[data-stade='2'] .pierres, .accueil[data-stade='3'] .pierres, .accueil[data-stade='3'] .bannieres { display: inline; }
  .accueil[data-stade='1'] .flamme { scale: .55; }
  .accueil[data-stade='2'] .flamme { scale: .8; }
  .bannieres { display: none; }
  .loin, .milieu { transition: transform .3s ease-out; }
  .eteint .corps { filter: brightness(.16) saturate(.3); }
  .yeux { fill: #f2b134; }
  /* tenues de grade : chaque pièce apparaît à partir de son grade ; la couronne remplace le chaperon et la plume */
  .feu :global(.acc) { display: none; }
  .animal:is([data-grade='2'], [data-grade='3'], [data-grade='4'], [data-grade='5'], [data-grade='6']) :global(.g2),
  .animal:is([data-grade='3'], [data-grade='4'], [data-grade='5'], [data-grade='6']) :global(.g3),
  .animal:is([data-grade='4'], [data-grade='5']) :global(.g4),
  .animal[data-grade='5'] :global(.g5),
  .animal[data-grade='6'] :global(.g6) { display: inline; }
  /* passage de grade : l'animal bondit dans la lumière */
  .promotion > g { transform-box: fill-box; transform-origin: 50% 100%; }
  @media (prefers-reduced-motion: no-preference) {
    .promotion > g { animation: bond .7s ease-out 3; }
    @keyframes bond { 40% { scale: 1.12; translate: 0 -6px; } }
  }
  .allume .corps, .yeux { transition: filter .4s; }
  .flamme { transform-origin: 300px 322px; animation: crepite 1.6s ease-in-out infinite alternate; }
  @keyframes crepite { to { transform: scale(1.04, .95); } }
  @media (prefers-reduced-motion: reduce) { .flamme { animation: none; } }
</style>

<script>
  import { lireEtat, stockageNavigateur } from '../lib/stockage/local';
  const etat = lireEtat(stockageNavigateur());
  // Chaque animal porte la tenue de son grade.
  for (const feu of document.querySelectorAll<SVGSVGElement>('.feu')) {
    const animaux: Record<string, string> = JSON.parse(feu.dataset.animaux!);
    for (const [theme, grade] of Object.entries(etat.grades)) {
      feu.querySelector(`[data-animal="${animaux[theme]}"]`)?.setAttribute('data-grade', String(grade));
    }
  }
  // Accueil : fait venir les animaux des thèmes joués et fait grandir le feu.
  for (const feu of document.querySelectorAll<SVGSVGElement>('.feu.accueil')) {
    const animaux: Record<string, string> = JSON.parse(feu.dataset.animaux!);
    const joues = etat.conjures.map((t) => animaux[t]).filter((a) => a && a !== 'renard');
    for (const a of joues) feu.querySelector(`[data-animal="${a}"]`)?.classList.remove('absent');
    feu.dataset.stade = joues.length >= 6 ? '3' : joues.length >= 3 ? '2' : '1';
  }
  // Parallaxe : le château et les montagnes bougent un peu avec la souris ou le téléphone.
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const bouger = (dx: number, dy: number) => {
      document.querySelectorAll<SVGGElement>('.feu .loin').forEach((g) => (g.style.transform = `translate(${dx * 10}px, ${dy * 5}px)`));
      document.querySelectorAll<SVGGElement>('.feu .milieu').forEach((g) => (g.style.transform = `translate(${dx * 4}px, ${dy * 2}px)`));
    };
    addEventListener('pointermove', (e) => bouger(e.clientX / innerWidth - 0.5, e.clientY / innerHeight - 0.5));
    addEventListener('deviceorientation', (e) => bouger((e.gamma ?? 0) / 45, ((e.beta ?? 45) - 45) / 45));
  }
</script>
