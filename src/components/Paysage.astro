---
// Paysage de l'accueil, façon Fantasy Hike : montagnes en silhouettes,
// la chaumière du gueux en bas, le château du roi au loin, et le goupil
// qui marche avec sa bannière. Couleurs dans theme.css (--nuit, --montagne-1/2/3).
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<svg class="paysage" viewBox="0 0 300 360" preserveAspectRatio="xMidYMax slice" role="img"
  aria-label="Le goupil marche de sa chaumière vers le château du roi, au loin">
  <rect width="300" height="360" fill="var(--nuit)" />
  <!-- étoiles -->
  <g fill="var(--or)" opacity=".7">
    <circle cx="30" cy="40" r="1.2" /><circle cx="90" cy="24" r="1" /><circle cx="200" cy="30" r="1.3" />
    <circle cx="260" cy="60" r="1" /><circle cx="120" cy="80" r=".9" /><circle cx="280" cy="20" r="1.1" />
  </g>

  <!-- montagnes du fond, avec le château du roi au sommet -->
  <path d="M0 170 50 122l40 28 60-90 55 55 40-30 55 55v220H0z" fill="var(--montagne-1)" />
  <g fill="var(--montagne-1)">
    <rect x="141" y="40" width="18" height="22" />
    <rect x="136" y="46" width="6" height="16" /><rect x="158" y="46" width="6" height="16" />
    <path d="M136 46h6v-4h-6zM158 46h6v-4h-6z" />
    <path d="M149 40v-9l8 3-8 3" />
  </g>

  <!-- montagnes du milieu -->
  <path d="M0 236 55 194l45 24 70-56 60 44 70-30v184H0z" fill="var(--montagne-2)" />

  <!-- premier plan : la pente où marche le goupil -->
  <path d="M0 360V318q100-14 170-40t130-34v116z" fill="var(--montagne-3)" />

  <!-- la chaumière du gueux -->
  <g fill="var(--montagne-3)">
    <path d="M18 320v-18h28v18z" />
    <path d="M12 304 32 284l20 20z" />
  </g>
  <rect x="28" y="308" width="6" height="8" fill="var(--or)" opacity=".85" />

  <!-- le goupil qui marche vers le château -->
  <defs>
    <filter id="silhouette">
      <feFlood flood-color="var(--montagne-3)" />
      <feComposite in2="SourceAlpha" operator="in" />
    </filter>
  </defs>
  <image class="marcheur" href={`${base}/goupil/renard.svg`} x="112" y="246" width="82" height="43" />
</svg>

<style>
  .paysage { display: block; width: 100%; height: 100%; }
  .marcheur { animation: pas 1.2s ease-in-out infinite alternate; transform-box: fill-box; }
  @keyframes pas { to { translate: 0 -1.5px; } }
</style>
