---
// Barre d'onglets du bas, façon appli : Accueil, Quiz, Révision, Classement.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const chemin = Astro.url.pathname.replace(base, '') || '/';
const liens = [
  { href: '/', nom: 'Accueil', icone: 'M4 11 12 4l8 7v9h-5v-6H9v6H4z' },
  { href: '/themes', nom: 'Quiz', icone: 'M3 5.5C6 4.3 9 4.5 11 6v13c-2-1.4-5-1.6-8-.5zM21 5.5C18 4.3 15 4.5 13 6v13c2-1.4 5-1.6 8-.5z' },
  { href: '/revision', nom: 'Révision', icone: 'M12 4a8 8 0 1 0 8 8h-2.5A5.5 5.5 0 1 1 12 6.5V9l4-3.5L12 2z' },
  { href: '/classement', nom: 'Classement', icone: 'M3 20V12h5v8zM9.5 20V6h5v14zM16 20v-6h5v6z' },
];
---
<nav class="nav" aria-label="Navigation principale">
  {liens.map((l) => {
    const actif = l.href === '/' ? chemin === '/' : chemin.startsWith(l.href);
    return (
      <a href={base + l.href} class:list={['lien', { actif }]} aria-current={actif ? 'page' : undefined}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d={l.icone} /></svg>
        <span class="nom">{l.nom}</span>
      </a>
    );
  })}
</nav>

<style>
  /* Barre d'onglets façon appli : collée en bas, pleine largeur, icône au-dessus du nom. */
  .nav {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    padding: 6px max(8px, env(safe-area-inset-left)) max(6px, env(safe-area-inset-bottom)) max(8px, env(safe-area-inset-right));
    background: var(--blanc);
    border-top: 1px solid color-mix(in srgb, var(--encre) 12%, transparent);
    z-index: 10;
  }
  .lien {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
    min-height: 52px;
    color: var(--encre-douce);
    text-decoration: none;
    font: 500 .75rem var(--police-texte);
    -webkit-tap-highlight-color: transparent;
  }
  .lien svg { width: 24px; height: 24px; fill: currentColor; padding: 3px 16px; box-sizing: content-box; border-radius: 999px; }
  .lien.actif { color: var(--sinople-fonce); font-weight: 600; }
  .lien.actif svg { background: var(--sinople-clair); }
  .lien:focus-visible { outline: 3px solid var(--sinople); outline-offset: -3px; border-radius: 12px; }
  @media (min-width: 640px) {
    .nav { left: 50%; right: auto; transform: translateX(-50%); width: 420px; bottom: 16px; border: 1px solid color-mix(in srgb, var(--encre) 12%, transparent); border-radius: 20px; padding: 6px; }
  }

  /* Pages de nuit (accueil) : la barre se fond dans la nuit. */
  :global(body.nuit) .nav { background: #12131f; border-color: color-mix(in srgb, var(--creme) 12%, transparent); }
  :global(body.nuit) .lien { color: var(--brume); }
  :global(body.nuit) .lien.actif { color: var(--or); }
  :global(body.nuit) .lien.actif svg { background: color-mix(in srgb, var(--or) 18%, transparent); }
  :global(body.nuit) .lien:focus-visible { outline-color: var(--or); }
</style>
