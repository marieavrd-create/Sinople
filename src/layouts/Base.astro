---
import '../styles/theme.css';
import '../styles/global.css';
import BarreNav from '../components/BarreNav.astro';

interface Props {
  titre: string;
  fond?: string;      // couleur de fond de la page, par défaut la crème du thème
  nuit?: boolean;     // page sombre (accueil, écran avant quiz) : contour clavier doré
  nav?: boolean;      // afficher la barre de navigation du bas
}
const { titre, fond, nuit = false, nav = true } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{titre} · Sinople</title>
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <!-- Icône de l'application : le renard et ses animaux autour du feu -->
    <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
    <link rel="manifest" href={`${base}/manifest.webmanifest`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600;700&family=IM+Fell+English:ital@0;1&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class:list={{ nuit }} style={fond ? `background:${fond}` : undefined}>
    <slot />
    {nav && <BarreNav />}
    {import.meta.env.PROD && (
      <script is:inline define:vars={{ base }}>
        // Garde le site et les leçons sur l'appareil, pour jouer sans réseau.
        if ('serviceWorker' in navigator) addEventListener('load', () => navigator.serviceWorker.register(`${base}/sw.js`, { scope: `${base}/` }));
      </script>
    )}
  </body>
</html>
